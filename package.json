{
  "name": "rougarou",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "ladle": "pnpm --filter @rougarou/ui run ladle",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "prettier": "@rougarou/config/prettier/index.json",
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@rougarou/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "lefthook": "2.2.2",
    "prettier": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
