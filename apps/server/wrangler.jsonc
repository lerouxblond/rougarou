{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rougarou",
  "main": "src/index.ts",
  // Date de compatibilite commune au Worker et aux tests. Elle est plafonnee
  // par le workerd embarque dans @cloudflare/vitest-plugin : la depasser ici
  // ferait tourner les tests sur un runtime different de la production.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],

  // La PWA et l'API sont servies par le meme Worker, donc par la meme origine :
  // les cookies de session restent en `SameSite=Lax` et le web n'a pas besoin
  // de CORS (docs/08).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // L'app est une SPA : une route inconnue rend `index.html`.
    "not_found_handling": "single-page-application",
    // ...sauf l'API et le WebSocket, qui doivent atteindre le Worker et jamais
    // le repli SPA.
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  // Base D1 (docs/08). Les bindings ne sont pas herites par les environnements :
  // chacun declare la sienne. Au niveau racine, `wrangler dev` utilise une base
  // locale ; l'identifiant de preview evite qu'une commande `--remote` lancee
  // sans `--env` touche la production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rougarou-db-preview",
      "database_id": "221aebf1-75ff-45e4-9604-121bd32dc30d",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    // Logs structures du Worker (docs/04 §Observabilite).
    "enabled": true
  },

  "env": {
    "preview": {
      "name": "rougarou-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rougarou-db-preview",
          "database_id": "221aebf1-75ff-45e4-9604-121bd32dc30d",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "rougarou",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rougarou-db",
          "database_id": "72fbd473-2a3f-461c-b5e0-10b45c5ac498",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
